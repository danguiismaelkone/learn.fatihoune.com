# Copy to .env.preprod on the server, then fill in. Never commit the filled file.
SITE_ENV=preview
SITE_DOMAIN=preprod.formation.fatihoune.com
NEXT_PUBLIC_SITE_URL=https://preprod.formation.fatihoune.com
CADDYFILE=Caddyfile.preprod
ENV_FILE=.env.preprod
PAYLOAD_SECRET=
PREVIEW_USER=recette
PREVIEW_PASSWORD=
SMTP_HOST=                                   # OVH: ssl0.ovh.net (port 587 or 465)
SMTP_PORT=587
SMTP_USER=infos@fatihoune.com                 # full OVH mailbox address
SMTP_PASS=
SMTP_FROM=infos@fatihoune.com                 # OVH only accepts the authenticated mailbox (or its alias)
NOTIFY_EMAILS=

# First start only: creates the administrator account if the database is empty. Remove after first login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
