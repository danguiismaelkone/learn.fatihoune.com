# Copy to .env.preprod on the server, then fill in. Never commit the filled file.
SITE_ENV=preview
SITE_DOMAIN=preprod.formation.fatihoune.com
NEXT_PUBLIC_SITE_URL=https://preprod.formation.fatihoune.com
# Bundled Caddy only (COMPOSE_PROFILES=caddy):
CADDYFILE=Caddyfile.preprod
ENV_FILE=.env.preprod
# --- Network (reverse proxy) ---
# free port on the server, e.g. 3010 — Nginx Proxy Manager forwards to it
APP_PORT=
# Docker bridge address: NPM can reach it, the internet cannot
APP_BIND=172.17.0.1
# only on a server WITHOUT a reverse proxy (bundled Caddy on 80/443)
# COMPOSE_PROFILES=caddy

# --- Application ---
# openssl rand -hex 32 — never change it afterwards
PAYLOAD_SECRET=
PREVIEW_USER=recette
PREVIEW_PASSWORD=
# OVH: ssl0.ovh.net (port 587 or 465)
SMTP_HOST=
SMTP_PORT=587
# full OVH mailbox address
SMTP_USER=infos@fatihoune.com
SMTP_PASS=
# OVH only accepts the authenticated mailbox (or its alias)
SMTP_FROM=infos@fatihoune.com
NOTIFY_EMAILS=

# First start only: creates the administrator account if the database is empty. Remove after first login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
