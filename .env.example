# --- Required ---
DATABASE_URL=file:./fatihoune.db           # docker-compose overrides this to file:/data/fatihoune.db
PAYLOAD_SECRET=                             # long random string: openssl rand -hex 32
NEXT_PUBLIC_SITE_URL=https://formation.fatihoune.com
SITE_ENV=production                         # anything else = noindex + password (pre-production)

# --- Pre-production protection (when SITE_ENV is not "production") ---
PREVIEW_USER=
PREVIEW_PASSWORD=

# --- E-mail notifications for new requests (optional; without them, requests are still saved in /admin) ---
SMTP_HOST=                                   # OVH: ssl0.ovh.net (port 587 or 465)
SMTP_PORT=587
SMTP_USER=infos@fatihoune.com                 # full OVH mailbox address
SMTP_PASS=
SMTP_FROM=infos@fatihoune.com                 # OVH only accepts the authenticated mailbox (or its alias)
NOTIFY_EMAILS=infos@fatihoune.com,kone.dangui@fatihoune.com           # fallback if not set in Réglages du site › Notifications

# --- Media storage (docker-compose sets /data/media) ---
MEDIA_DIR=media

# --- Seeding / local development only ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
DEV_AUTOLOGIN=false
