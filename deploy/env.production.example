# Copy to .env.production on the server, then fill in. Never commit the filled file.
SITE_ENV=production
SITE_DOMAIN=formation.fatihoune.com
NEXT_PUBLIC_SITE_URL=https://formation.fatihoune.com
CADDYFILE=Caddyfile.production
ENV_FILE=.env.production
PAYLOAD_SECRET=
SMTP_HOST=                                   # OVH: ssl0.ovh.net (port 587 or 465)
SMTP_PORT=587
SMTP_USER=infos@fatihoune.com                 # full OVH mailbox address
SMTP_PASS=
SMTP_FROM=infos@fatihoune.com                 # OVH only accepts the authenticated mailbox (or its alias)
NOTIFY_EMAILS=infos@fatihoune.com,kone.dangui@fatihoune.com

# First start only: creates the administrator account if the database is empty. Remove after first login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
