# Created by "make env" (or copy to .env.production), then fill in. Never commit the filled file.
SITE_ENV=production
NEXT_PUBLIC_SITE_URL=https://formation.fatihoune.com
ENV_FILE=.env.production
# --- Network (reverse proxy) ---
# free port on the server (e.g. 3018), given to Nginx Proxy Manager — check: ss -ltn | grep :3018
APP_PORT=
# Docker bridge address: NPM can reach it, the internet cannot
APP_BIND=172.17.0.1

# --- Application ---
# generated by "make env" (or: openssl rand -hex 32) — never change it afterwards
PAYLOAD_SECRET=
# OVH: ssl0.ovh.net (port 587 or 465)
SMTP_HOST=
SMTP_PORT=587
# full OVH mailbox address
SMTP_USER=infos@fatihoune.com
SMTP_PASS=
# OVH only accepts the authenticated mailbox (or its alias)
SMTP_FROM=infos@fatihoune.com
NOTIFY_EMAILS=infos@fatihoune.com,kone.dangui@fatihoune.com

# First start only: creates the administrator account if the database is empty. Remove after first login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
