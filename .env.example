# --- Required ---
# docker-compose overrides this to file:/data/fatihoune.db
DATABASE_URL=file:./fatihoune.db
# long random string: openssl rand -hex 32
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=https://formation.fatihoune.com
# anything else = noindex + password (pre-production)
SITE_ENV=production

# --- Pre-production protection (when SITE_ENV is not "production") ---
PREVIEW_USER=
PREVIEW_PASSWORD=

# --- E-mail notifications for new requests (optional; without them, requests are still saved in /admin) ---
# OVH: ssl0.ovh.net (port 587 or 465)
SMTP_HOST=
SMTP_PORT=587
# full OVH mailbox address
SMTP_USER=infos@fatihoune.com
SMTP_PASS=
# OVH only accepts the authenticated mailbox (or its alias)
SMTP_FROM=infos@fatihoune.com
# fallback if not set in Réglages du site › Notifications
NOTIFY_EMAILS=infos@fatihoune.com,kone.dangui@fatihoune.com

# --- Media storage (docker-compose sets /data/media) ---
MEDIA_DIR=media

# --- Seeding / local development only ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
DEV_AUTOLOGIN=false
